package-as: TweaksForever

move-folders:
  TweaksForever/ForeverCore: ForeverCore
  TweaksForever/LibAHTab: LibAHTab

manual-changelog:
  filename: .release-notes.md
  markup-type: markdown

ignore:
  - .agents
  - .sloppatrol
  - AGENTS.md
  - tools
  - tests
  - types
  - docs
  - forever-core
  - media/icon.svg
  - media/icon-400.png
  - stylua.toml
  - ruff.toml
  - Locales/phrases.txt
  - Locales/README.md
  - .claude

# CurseForge relations: the CurseForge slug of every OptionalDeps folder in the root .toc (WFA-28).
optional-dependencies:
  - shortest-path-forever
  - questiedb
  - questie

# ForeverCore ships inside this zip as its own folder, from the release tools/forever-core.txt pins, because
# its CurseForge project is not yet approved and so cannot be a required-dependencies relation.
externals:
  ForeverCore: https://github.com/cjber/forever-core/releases/download/v1.1.0/ForeverCore-v1.1.0-forever.zip
