package-as: TweaksForever

move-folders:
  TweaksForever/ForeverCore: ForeverCore

manual-changelog:
  filename: .release-notes.md
  markup-type: markdown

ignore:
  - .agents
  - .sloppatrol
  - AGENTS.md
  - tools
  - tests
  - types
  - docs
  - forever-core
  - media/icon.svg
  - media/icon-400.png
  - stylua.toml
  - ruff.toml
  - Locales/phrases.txt
  - Locales/README.md
  - .claude

# CurseForge relations: the CurseForge slug of every OptionalDeps folder in the root .toc (WFA-28).
optional-dependencies:
  - shortest-path-forever
  - questiedb
  - questie

# ForeverCore ships inside this zip as its own folder, at the release tools/forever-core.txt pins, so an
# update brings it along: players who updated did not get it as a required dependency, and Wago's uploads
# carry no dependencies at all.
externals:
  ForeverCore: https://github.com/cjber/forever-core/releases/download/v1.10.0/ForeverCore-v1.10.0-forever.zip
