package-as: TweaksForever

# CurseForge installs ForeverCore (slug forevercore, project 1796337) with the addon; the TOC's
# `## Dependencies: ForeverCore` is what the client reads.
required-dependencies:
  - forevercore

move-folders:
  TweaksForever/LibAHTab: LibAHTab

manual-changelog:
  filename: .release-notes.md
  markup-type: markdown

ignore:
  - .agents
  - .sloppatrol
  - AGENTS.md
  - tools
  - tests
  - types
  - docs
  - forever-core
  - media/icon.svg
  - media/icon-400.png
  - stylua.toml
  - ruff.toml
  - Locales/phrases.txt
  - Locales/README.md
  - .claude

# CurseForge relations: the CurseForge slug of every OptionalDeps folder in the root .toc (WFA-28).
optional-dependencies:
  - shortest-path-forever
  - questiedb
  - questie
